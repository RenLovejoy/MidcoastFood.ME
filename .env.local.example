# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres. Provision it from the Vercel dashboard:
#   Project → Storage → Create Database → Neon
# Vercel injects DATABASE_URL into the deployed app automatically. For local
# dev, pull it down with:  vercel env pull .env.local
DATABASE_URL=

# ── Map tiles (CARTO basemaps) ──────────────────────────────────────────────
# Required since 23 Sep 2026 — without it every tile shows an "API key
# required" watermark. Free for non-profits: https://carto.com/basemaps/apikey
# Public by design (it's sent with every tile request). Set it in Vercel for
# Production and Preview, then redeploy: NEXT_PUBLIC_ vars are baked in at build.
NEXT_PUBLIC_CARTO_API_KEY=

# ── Form submission emails (Resend) ─────────────────────────────────────────
# Free key at https://resend.com — submissions email ren@sunshinehouse.xyz.
RESEND_API_KEY=

# Optional overrides:
# RESEND_FROM="Midcoast Food <forms@midcoastfood.me>"
# RESEND_TO=ren@sunshinehouse.xyz
